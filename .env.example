# Path to the existing Laravel SQLite database (shared, not copied).
DATABASE_PATH=/absolute/path/to/keycar/database/database.sqlite

# Base URL of the Laravel app, used to resolve legacy upload paths.
LARAVEL_PUBLIC_URL=http://127.0.0.1:8000

APP_NAME=Keycar
APP_URL=http://localhost:3000
DEFAULT_LANG=en

# Cloudinary — admin car image upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Signs the admin session cookie — use a long random string
ADMIN_SESSION_SECRET=
